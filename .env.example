# Application
APP_NAME=DroneMissionControl
# development | simulation | staging | production | test
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# API
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]

# Database
DATABASE_URL=postgresql+asyncpg://dmc:dmc@localhost:5432/drone_mission_control

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TELEMETRY_CHANNEL=dmc:telemetry
REDIS_TELEMETRY_TTL_SECONDS=30

# MQTT
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=dmc/telemetry

# Auth (replace in production)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

# Drone adapters: simulated | gazebo | px4 | dji_cloud
DRONE_DEFAULT_ADAPTER=simulated
# PX4 SITL + Gazebo MAVLink (used when adapter=gazebo or APP_ENV=simulation)
# PX4 SITL GCS link: MAVSDK listens on 14550 (not 14540 / 14580).
MAVSDK_SIM_ADDRESS=udpin://0.0.0.0:14550
# Real hardware
MAVSDK_HW_ADDRESS=serial:///dev/ttyUSB0:921600
TELEMETRY_PUBLISH_HZ=5.0

# Frontend
VITE_API_BASE=/api/v1
